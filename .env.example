# Placeholders only. Never commit real keys.
DATABASE_URL=sqlite:///./applypilot.db
# For PostgreSQL: postgresql+psycopg://user:password@localhost:5432/applypilot
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=5
# Add your key to enable AI resume analysis and AI cover letters (otherwise rule-based / template fallbacks are used).
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=
# Real jobs: free key at developer.adzuna.com (Remotive needs no key)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in

# Hosting: set a password to require sign-in (leave empty for local use)
APP_PASSWORD=
SECRET_KEY=
COOKIE_SECURE=false
# Optional extra sources: comma-separated company slugs that publish public job boards
GREENHOUSE_BOARDS=
LEVER_COMPANIES=
